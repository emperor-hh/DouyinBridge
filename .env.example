# Dedicated AstrBot OneBot v11 reverse WebSocket endpoint
ONEBOT_WS_URL=ws://127.0.0.1:6200/ws
ONEBOT_ACCESS_TOKEN=change-to-strong-secret
UPSTREAM_DIR=./upstream/dsh-douyin-agent
DATA_DIR=./data

# Browser
BROWSER_MODE=headless
BROWSER_CHANNEL=chromium
BROWSER_PROFILE_DIR=./data/browser-profile
POLL_MS=2500

# Web management panel bound to localhost; ADMIN_TOKEN may be left empty to generate per start
ADMIN_PORT=3219
ADMIN_TOKEN=

# Backward compatibility: imported into SQLite on first run only
ALLOWED_CONVERSATIONS=

# Keep false until real Douyin send flow is validated
ENABLE_SENDING=false
GROUP_TRIGGER=all
