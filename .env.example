# Dedicated AstrBot OneBot v11 reverse WebSocket endpoint
# Use a strong unique token that matches AstrBot. The placeholder below is rejected on startup.
ONEBOT_WS_URL=ws://127.0.0.1:6200/ws
ONEBOT_ACCESS_TOKEN=change-to-strong-secret
UPSTREAM_DIR=./upstream/dsh-douyin-agent
DATA_DIR=./data

# Browser
BROWSER_MODE=headless
BROWSER_CHANNEL=chromium
BROWSER_PROFILE_DIR=./data/browser-profile
POLL_MS=2500

# Web management panel bound to localhost; ADMIN_TOKEN may be left empty to generate per start
ADMIN_PORT=3219
ADMIN_TOKEN=

# Backward compatibility: imported into SQLite on first run only
ALLOWED_CONVERSATIONS=

# Keep false until real Douyin send flow is validated
ENABLE_SENDING=false
# Extra global gate for uploading image stickers (requires ENABLE_SENDING=true too)
ENABLE_IMAGE_SENDING=false
# Incoming Douyin sticker cards are forwarded as text + bounded screenshot if possible
RECEIVE_STICKERS=true
# Automation disabled until explicitly enabled; planned jobs additionally require
# enabled plans and per-conversation auto-share permission in the Web admin.
ENABLE_AUTO_BROWSING=false
ENABLE_AUTO_SHARING=false
# Forward Douyin shared video/photo cards as OneBot text; does not play videos
SHARED_VIDEO_FORWARDING=true
# 1-5 seconds of video playback per explicitly requested analysis
VIDEO_SAMPLE_SECONDS=3
GROUP_TRIGGER=all
